Dialogue: 0,0:01:20.42,0:01:23.40,Shot,,0,0,0,,{\pos(12,10)}S22  "Down in South Memphis, sister"
Dialogue: 0,0:01:23.40,0:01:27.90,Shot,,0,0,0,,{\pos(12,10)}S23  "they rolled the turbines in"
Dialogue: 0,0:01:27.90,0:01:30.44,Shot,,0,0,0,,{\pos(12,10)}S24  "Thirty-five of 'em a-burning"
Dialogue: 0,0:01:30.44,0:01:35.21,Shot,,0,0,0,,{\pos(12,10)}S25  "nobody asked the wind"
Dialogue: 0,0:01:35.21,0:01:41.66,Shot,,0,0,0,,{\pos(12,10)}S26  "No permit on the paperwork, no notice on the door"
Dialogue: 0,0:01:41.66,0:01:49.74,Shot,,0,0,0,,{\pos(12,10)}S27  "a haze above the schoolyard, and the lawyers at the door"
Dialogue: 0,0:01:49.74,0:01:52.46,Shot,,0,0,0,,{\pos(12,10)}S32  "Back in seventy-nine we gathered"
Dialogue: 0,0:01:52.46,0:01:55.66,Shot,,0,0,0,,{\pos(12,10)}S33  "sang the reactors down"
Dialogue: 1,0:01:52.46,0:01:55.66,Shot,,0,0,0,,{\pos(12,32)}S33a  "sang the reactors down"
Dialogue: 0,0:01:55.66,0:01:59.62,Shot,,0,0,0,,{\pos(12,10)}S34  "Now they're waking Three Mile Island"
