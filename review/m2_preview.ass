Dialogue: 0,0:00:00.14,0:00:07.31,Shot,,0,0,0,,{\pos(12,10)}S02  First twelve-string strum
Dialogue: 0,0:00:07.31,0:00:09.28,Shot,,0,0,0,,{\pos(12,10)}S03  Wordless harmonies
Dialogue: 0,0:00:09.28,0:00:14.16,Shot,,0,0,0,,{\pos(12,10)}S04  End of intro
Dialogue: 0,0:00:14.16,0:00:17.68,Shot,,0,0,0,,{\pos(12,10)}S05  "Out in Salix, Iowa"
Dialogue: 0,0:00:17.68,0:00:22.22,Shot,,0,0,0,,{\pos(12,10)}S06  "where the corn grew to the sky"
Dialogue: 0,0:00:22.22,0:00:24.62,Shot,,0,0,0,,{\pos(12,10)}S07  "They annexed nine hundred acres"
Dialogue: 0,0:00:24.62,0:00:29.99,Shot,,0,0,0,,{\pos(12,10)}S08  "and they never told us why"
Dialogue: 0,0:00:29.99,0:00:31.79,Shot,,0,0,0,,{\pos(12,10)}S09  "a building with no windows"
Dialogue: 0,0:00:31.79,0:00:39.62,Shot,,0,0,0,,{\pos(12,10)}S10  "where my granddad turned the ground"
Dialogue: 0,0:00:39.62,0:00:44.26,Shot,,0,0,0,,{\pos(12,10)}S11  "a low and endless sound"
Dialogue: 0,0:00:44.26,0:00:46.98,Shot,,0,0,0,,{\pos(12,10)}S12  "Can you hear it humming, brother?"
Dialogue: 0,0:00:46.98,0:00:51.78,Shot,,0,0,0,,{\pos(12,10)}S13  "Can you hear it in the corn?"
Dialogue: 0,0:00:51.78,0:00:54.26,Shot,,0,0,0,,{\pos(12,10)}S14  "the sound of something thinking"
Dialogue: 0,0:00:54.26,0:00:57.32,Shot,,0,0,0,,{\pos(12,10)}S15  "Since the morning it was born"
Dialogue: 0,0:00:57.32,0:01:04.95,Shot,,0,0,0,,{\pos(12,10)}S16  "And it never sleeps, and it never stops, / And it's wired to everything"
Dialogue: 0,0:01:04.95,0:01:08.69,Shot,,0,0,0,,{\pos(12,10)}S17  "the cloud ain't up in heaven"
Dialogue: 0,0:01:08.69,0:01:20.42,Shot,,0,0,0,,{\pos(12,10)}S18  "It's a field of humming things"
Dialogue: 1,0:01:12.39,0:01:14.89,Shot,,0,0,0,,{\pos(12,32)}S19  Failure span 1 starts
Dialogue: 1,0:01:17.52,0:01:20.02,Shot,,0,0,0,,{\pos(12,32)}S20  Mid-span
